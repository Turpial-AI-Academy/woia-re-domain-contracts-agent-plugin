      "1NF",
      "2NF",
      "3NF",
      "BCNF",
      "4NF",
      "5NF"
    ],
    "independent_evidence": [
      "lossless_reconstruction_evidence",
      "enforceability_evidence"
    ],
    "relation_catalog": "logical-relations.json",
    "relation_count": 85
