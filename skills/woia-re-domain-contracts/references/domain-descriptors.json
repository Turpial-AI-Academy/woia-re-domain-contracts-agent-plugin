    "schema": "dev.woia.real-estate-representation-policy/v1",
    "source_relations": [
      "Mandate",
      "MandateVersion",
      "MandateAuthorityScope"
    ],
    "required_checks": [
      "represented-principal",
      "mandate-version",
      "property-scope",
      "power-code",
      "source-authority-map",
      "policy-revision",
      "recipient-counterparty",
      "material-command-digest",
      "monetary-and-aggregate-limits",
      "approval-validity",
      "hold-revocation-emergency-stop"
    ],
    "initial_human_boundaries": [
      "commercial Negotiation",
      "Offer creation/transmission/acceptance as a commercial commitment",
      "economic obligation exception/waiver/concession unless an explicitly approved fixed exact action",
      "legal/professional applicability and external professional acts",
      "grant/delegation creation or enlargement",
      "exceptional beneficiary/account substitution"
    ],
    "model_contributions": [
      "prepare",
      "compare",
      "summarize",
      "record attributable competent human decisions"
    ]
  },
  "sales": {
    "id": "real-estate.opportunity-links",
    "entity": "Opportunity",
    "domain_refs": [
