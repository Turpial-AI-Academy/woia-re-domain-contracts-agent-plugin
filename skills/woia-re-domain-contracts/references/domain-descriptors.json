          "signature",
          "initial_money",
          "physical_handover"
        ],
        "administration_transfer": [
          "receiver_acceptance"
        ]
      }
    },
    "asset-management": {
      "id": "real-estate.asset-management-outcomes",
      "phases": {
        "administration_entry": [
          "receiver_acceptance",
          "source_position"
        ],
        "maintenance_outcome": [
          "work_evidence",
          "competent_acceptance"
        ],
        "contract_change": [
          "competent_decision",
          "source_version"
        ]
      }
    }
  },
